  "repairs": [
    {
      "id": "slice5-eta-profile-envelope",
      "file": "paper/source/chapters/11_epplus_eta_profiles.tex",
      "locator": "line 2 and Table tab:california-eta-profiles-unscaled line 33",
      "finding": "The archived profiled (a,d,n) curve used power=12 Sobol nodes and a seven-point PCHIP interpolation, while the fixed-backbone curve used power=14 and exact brentq roots. The mismatch produced F0 1.1398e-4 < 1.1414e-4, violating the envelope inequality eta_profiled >= eta_fixed that follows from max_{a,d,n} l(a,d,n,eta) >= l(a0,d0,n0,eta). The audit recomputes the profile at power=14 with the same frozen importance weights and exact brentq roots. Every fold now satisfies the inequality strictly.",
      "status": "fixed"
    },
    {
      "id": "slice5-eta-profile-unscaled",
      "file": "paper/source/chapters/11_epplus_eta_profiles.tex",
      "locator": "Table tab:california-eta-profiles-unscaled and caption",
      "finding": "The archived unscaled ell=15 km roots were also coarse-grid PCHIP values. They are replaced by exact power=14 brentq roots; the unscaled-to-scaled ratio is restated as roughly six to eight rather than eight.",
      "status": "fixed"
    },
    {
      "id": "slice5-sigma0-double-count-clarification",
      "file": "paper/source/chapters/11_epplus_ablation.tex",
      "locator": "line 4",
      "finding": "The manuscript stated only that the archived 154.114-nat total double-counted the plane and rectangle panels. The sealed Track B rows give 77.056 (plane) and 77.059 (rectangle). The review brief's 154.053-nat reading (77.056 + 76.997) is not present in any sealed authority and is explicitly withdrawn in the repaired sentence.",
      "status": "fixed"
    },
    {
      "id": "slice5-claim-ledger-rebinding",
      "file": "validation/MASTER_CLAIM_LEDGER.json",
      "locator": "claims track-b-20261112-287/288/289",
      "finding": "Three typed manuscript claims bound the displays 1.1398e-4, 1.1187e-4 and 9.2864e-5 to the archived power=12 PCHIP roots. They are rebound to the deterministic power=14 roots in validation/live_results/slice5_audit_20261114/eta_profile_roots_authority.json and the custody receipt is refreshed.",
      "status": "fixed"
    }
  ],
